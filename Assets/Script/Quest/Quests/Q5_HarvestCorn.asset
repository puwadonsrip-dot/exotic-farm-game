  objective: 2
  objectiveText: "\u0E40\u0E01\u0E47\u0E1A\u0E40\u0E01\u0E35\u0E48\u0E22\u0E27\u0E02\u0E49\u0E32\u0E27\u0E42\u0E1E\u0E14"
  targetCropId: corn
  requiredAmount: 5
  returnToNPC: 1
  completeLines:
  - "\u0E1D\u0E31\u0E01\u0E43\u0E2B\u0E0D\u0E48\u0E21\u0E32\u0E01! \u0E40\u0E18\u0E2D\u0E14\u0E39\u0E41\u0E25\u0E21\u0E31\u0E19\u0E14\u0E35\u0E08\u0E23\u0E34\u0E07\u0E46"
  - "\u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E40\u0E18\u0E2D\u0E23\u0E39\u0E49\u0E2B\u0E21\u0E14\u0E41\u0E25\u0E49\u0E27\u0E27\u0E48\u0E32\u0E1F\u0E32\u0E23\u0E4C\u0E21\u0E17\u0E33\u0E07\u0E32\u0E19\u0E22\u0E31\u0E07\u0E44\u0E07"

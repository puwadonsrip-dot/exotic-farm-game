MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 39186611}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2ee5d7180091af4d9788fa79ff84f33, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroCutscene
  playEveryTime: 0
  delay: 0.15
  lines:
  - image: {fileID: 2800000, guid: 217a286d08a8a3f4fb8bf8ed1587a5dc, type: 3}
    speaker: 
    text: "\u0E13 \u0E2B\u0E21\u0E39\u0E48\u0E1A\u0E49\u0E32\u0E19\u0E40\u0E25\u0E47\u0E01\u0E46
      \u0E17\u0E35\u0E48\u0E42\u0E2D\u0E1A\u0E25\u0E49\u0E2D\u0E21\u0E14\u0E49\u0E27\u0E22\u0E20\u0E39\u0E40\u0E02\u0E32\u0E41\u0E25\u0E30\u0E17\u0E38\u0E48\u0E07\u0E01\u0E27\u0E49\u0E32\u0E07\n\u0E21\u0E35\u0E1F\u0E32\u0E23\u0E4C\u0E21\u0E23\u0E49\u0E32\u0E07\u0E2B\u0E25\u0E31\u0E07\u0E2B\u0E19\u0E36\u0E48\u0E07
      \u0E17\u0E35\u0E48\u0E23\u0E2D\u0E40\u0E08\u0E49\u0E32\u0E02\u0E2D\u0E07\u0E01\u0E25\u0E31\u0E1A\u0E21\u0E32\u0E19\u0E32\u0E19\u0E2B\u0E25\u0E32\u0E22\u0E1B\u0E35"
  - image: {fileID: 2800000, guid: acb3639eb11fca744a98930b63362cc8, type: 3}
    speaker: "\u0E1E\u0E35\u0E48\u0E2A\u0E32\u0E27\u0E0A\u0E32\u0E27\u0E1A\u0E49\u0E32\u0E19"
    text: "\u0E2D\u0E49\u0E32\u0E27! \u0E01\u0E25\u0E31\u0E1A\u0E21\u0E32\u0E08\u0E19\u0E44\u0E14\u0E49\u0E19\u0E30
      \u0E23\u0E2D\u0E15\u0E31\u0E49\u0E07\u0E19\u0E32\u0E19\n\u0E14\u0E35\u0E43\u0E08\u0E08\u0E23\u0E34\u0E07\u0E46
      \u0E17\u0E35\u0E48\u0E44\u0E14\u0E49\u0E40\u0E08\u0E2D\u0E01\u0E31\u0E19\u0E2D\u0E35\u0E01"
  - image: {fileID: 2800000, guid: fd00b59faa5842c44bd0e27399818315, type: 3}
    speaker: "\u0E1E\u0E35\u0E48\u0E2A\u0E32\u0E27\u0E0A\u0E32\u0E27\u0E1A\u0E49\u0E32\u0E19"
    text: "\u0E1F\u0E32\u0E23\u0E4C\u0E21\u0E2B\u0E25\u0E31\u0E07\u0E19\u0E35\u0E49\u0E40\u0E04\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13\u0E1B\u0E39\u0E48\u0E40\u0E18\u0E2D
      \u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E40\u0E1B\u0E47\u0E19\u0E02\u0E2D\u0E07\u0E40\u0E18\u0E2D\u0E41\u0E25\u0E49\u0E27\n\u0E14\u0E39\u0E23\u0E01\u0E44\u0E1B\u0E2B\u0E19\u0E48\u0E2D\u0E22
      \u0E41\u0E15\u0E48\u0E14\u0E34\u0E19\u0E22\u0E31\u0E07\u0E14\u0E35\u0E2D\u0E22\u0E39\u0E48\u0E19\u0E30
      \u0E02\u0E32\u0E14\u0E41\u0E04\u0E48\u0E04\u0E19\u0E25\u0E07\u0E21\u0E37\u0E2D"
  - image: {fileID: 2800000, guid: 2d12051869df4a84883b7aed71b51b67, type: 3}
    speaker: "\u0E1E\u0E35\u0E48\u0E2A\u0E32\u0E27\u0E0A\u0E32\u0E27\u0E1A\u0E49\u0E32\u0E19"
    text: "\u0E40\u0E23\u0E34\u0E48\u0E21\u0E07\u0E48\u0E32\u0E22\u0E46 \u2014 \u0E1E\u0E23\u0E27\u0E19\u0E14\u0E34\u0E19\u0E14\u0E49\u0E27\u0E22\u0E08\u0E2D\u0E1A
      \u0E41\u0E25\u0E49\u0E27\u0E2B\u0E22\u0E2D\u0E14\u0E40\u0E21\u0E25\u0E47\u0E14\u0E25\u0E07\u0E44\u0E1B\n\u0E21\u0E35\u0E02\u0E49\u0E32\u0E27\u0E2A\u0E32\u0E25\u0E35
      \u0E41\u0E04\u0E23\u0E2D\u0E17 \u0E01\u0E31\u0E1A\u0E02\u0E49\u0E32\u0E27\u0E42\u0E1E\u0E14
      \u0E40\u0E25\u0E37\u0E2D\u0E01\u0E1B\u0E25\u0E39\u0E01\u0E44\u0E14\u0E49\u0E15\u0E32\u0E21\u0E43\u0E08\u0E40\u0E25\u0E22"
  - image: {fileID: 2800000, guid: 407c96e1c77d25f40aea8b7abd8e994b, type: 3}
    speaker: "\u0E1E\u0E35\u0E48\u0E2A\u0E32\u0E27\u0E0A\u0E32\u0E27\u0E1A\u0E49\u0E32\u0E19"
    text: "\u0E23\u0E14\u0E19\u0E49\u0E33\u0E17\u0E38\u0E01\u0E27\u0E31\u0E19\u0E19\u0E30
      \u0E2A\u0E32\u0E21\u0E27\u0E31\u0E19\u0E01\u0E47\u0E40\u0E01\u0E47\u0E1A\u0E40\u0E01\u0E35\u0E48\u0E22\u0E27\u0E44\u0E14\u0E49\u0E41\u0E25\u0E49\u0E27\n\u0E40\u0E01\u0E47\u0E1A\u0E44\u0E14\u0E49\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E44\u0E2B\u0E23\u0E48\u0E40\u0E2D\u0E32\u0E21\u0E32\u0E02\u0E32\u0E22\u0E43\u0E2B\u0E49\u0E1E\u0E35\u0E48
      \u0E1E\u0E35\u0E48\u0E23\u0E31\u0E1A\u0E0B\u0E37\u0E49\u0E2D\u0E2B\u0E21\u0E14\u0E40\u0E25\u0E22"
  - image: {fileID: 2800000, guid: 65c2cc1f4caa4094099655368f4f994d, type: 3}
    speaker: 
    text: "\u0E41\u0E15\u0E48\u0E43\u0E19\u0E1B\u0E48\u0E32\u0E2B\u0E25\u0E31\u0E07\u0E1F\u0E32\u0E23\u0E4C\u0E21\u0E19\u0E31\u0E49\u0E19
      \u0E21\u0E35\u0E1A\u0E32\u0E07\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E40\u0E1D\u0E49\u0E32\u0E21\u0E2D\u0E07\u0E40\u0E18\u0E2D\u0E2D\u0E22\u0E39\u0E48\u0E40\u0E07\u0E35\u0E22\u0E1A\u0E46...\n\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E19\u0E31\u0E49\u0E19\u0E04\u0E48\u0E2D\u0E22\u0E27\u0E48\u0E32\u0E01\u0E31\u0E19
      \u2014 \u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E44\u0E1B\u0E40\u0E23\u0E34\u0E48\u0E21\u0E27\u0E31\u0E19\u0E41\u0E23\u0E01\u0E02\u0E2D\u0E07\u0E40\u0E18\u0E2D\u0E01\u0E31\u0E19\u0E01\u0E48\u0E2D\u0E19"
